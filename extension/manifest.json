{
  "manifest_version": 3,
  "name": "YouTube Music Audio Only",
  "version": "1.0.0",
  "description": "Halts video streaming and decoding on YouTube Music to reduce CPU/GPU load and keep laptop temperatures cool.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://music.youtube.com/*"
  ],
  "action": {
    "default_title": "YouTube Music Audio Only",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}
