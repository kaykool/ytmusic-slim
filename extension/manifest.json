{
  "manifest_version": 3,
  "name": "YouTube Music Audio Only",
  "version": "1.0.0",
  "description": "Halts video streaming and decoding on YouTube Music to reduce CPU/GPU load and keep laptop temperatures cool.",
  "host_permissions": [
    "*://music.youtube.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}
